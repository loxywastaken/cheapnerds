]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">TextureIds</string><ProtectedString name="Source"><![CDATA[-- TextureIds (ModuleScript inside the SniperSystem folder).
--
-- Upload each PNG from roblox-snipers/textures/ (Studio: Asset Manager > Bulk
-- Import, or the Creator Hub), then paste its id here. Pattern skins skip a
-- texture whose id is still 0 and just use their colours.

return {
	camo_woodland = "rbxassetid://0",
	camo_desert = "rbxassetid://0",
	camo_arctic = "rbxassetid://0",
	camo_digital = "rbxassetid://0",
	tiger = "rbxassetid://0",
	carbon = "rbxassetid://0",
	galaxy = "rbxassetid://0",
	lava = "rbxassetid://0",
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">SniperSkins</string><ProtectedString name="Source"><![CDATA[--!strict
-- SniperSkins (ModuleScript inside the SniperSystem folder, next to
-- SniperData, SkinCatalog and TextureIds).
--
-- Every rifle is built from MeshParts named after the same 15 slots
-- (Body, Stock, Pad, Grip, Barrel, Handguard, Muzzle, Scope, Lens, Mount,
-- Magazine, Bolt, Trigger, Bipod, Accent). A skin is just a look per slot,
-- so every skin fits every rifle.
--
--   SniperSkins.Apply(model, "Gold Rush")       -- colour skin
--   SniperSkins.Apply(model, "Woodland")        -- pattern skin (needs TextureIds)
--   SniperSkins.Apply(model, "Factory")         -- back to the rifle's own colours
--
-- Your own skins:
--   SniperSkins.Register("Dragon", {
--       Default = { Color = Color3.fromRGB(30, 10, 10), Material = Enum.Material.SmoothPlastic },
--       Barrel  = { Color = Color3.fromRGB(255, 80, 0), Material = Enum.Material.Neon },
--       -- optional: a texture painted on templates/<Rifle>_uv.png, per rifle
--       Atlas   = { Raptor = "rbxassetid://123456" },
--   })

local root = script.Parent
local SniperData = require(root:WaitForChild("SniperData"))
local SkinCatalog = require(root:WaitForChild("SkinCatalog"))
local TextureIds = require(root:WaitForChild("TextureIds"))

export type Look = { Color: Color3, Material: Enum.Material, Texture: string? }

local SniperSkins = {}

SniperSkins.Slots = {
	"Body", "Stock", "Pad", "Grip", "Barrel", "Handguard", "Muzzle", "Scope",
	"Lens", "Mount", "Magazine", "Bolt", "Trigger", "Bipod", "Accent",
}

-- Lens and Accent keep the rifle's factory glow unless a skin sets them.
local KEEP_FACTORY = { Lens = true, Accent = true }

local skins: { [string]: any } = table.clone(SkinCatalog.Skins)
local order: { string } = table.clone(SkinCatalog.Order)
local warned: { [string]: boolean } = {}

function SniperSkins.Register(name: string, skin: { [string]: any })
	assert(skin.Default or skin.Atlas, "a skin needs a Default look or an Atlas")
	if not skins[name] then
		table.insert(order, name)
	end
	skins[name] = skin
end

function SniperSkins.Get(name: string)
	return skins[name]
end

-- Skin names in display order ("Factory" first).
function SniperSkins.List(): { string }
	return table.clone(order)
end

-- Which slot a part fills. Accepts "Body", and importer names like
-- "Hawkeye_Body" or "Body.001". A "Slot" attribute wins over the name.
function SniperSkins.SlotOf(part: Instance): string?
	local tagged = part:GetAttribute("Slot")
	if typeof(tagged) == "string" then
		return tagged
	end
	for word in part.Name:gmatch("%a+") do
		if table.find(SniperSkins.Slots, word) then
			return word
		end
	end
	return nil
end

local function textureId(name: string?): string?
	if not name then
		return nil
	end
	-- a texture is either a name from TextureIds or an asset id used directly
	local id = if name:find("://") then name else TextureIds[name]
	if id == nil or id == "" or id == "rbxassetid://0" then
		if not warned[name] then
			warned[name] = true
			warn(`[SniperSkins] no asset id for texture "{name}" yet; set it in TextureIds`)
		end
		return nil
	end
	return id
end

local function rifleNameOf(model: Instance): string
	local attr = model:GetAttribute("Sniper")
	return if typeof(attr) == "string" then attr else model.Name
end

-- Applies a skin to every slot part under `model` (a Model or a Tool).
function SniperSkins.Apply(model: Instance, skinName: string, rifleName: string?)
	local rifle = rifleName or rifleNameOf(model)
	local data = SniperData[rifle]
	local skin = if skinName == "Factory" then nil else skins[skinName]
	if skinName ~= "Factory" and not skin then
		warn(`[SniperSkins] unknown skin "{skinName}"`)
		return
	end
	local atlas = skin and skin.Atlas and textureId(skin.Atlas[rifle]) or nil

	for _, part in model:GetDescendants() do
		if not part:IsA("BasePart") then
			continue
		end
		local slot = SniperSkins.SlotOf(part)
		if not slot then
			continue
		end
		local factory: Look? = data and data.Factory[slot] or nil
		local look: Look? = factory
		local texture: string? = nil
		if skin then
			local own = skin[slot]
			if own then
				look = own
			elseif not (KEEP_FACTORY[slot] and factory) then
				look = skin.Default or factory
			end
			if atlas then
				texture = atlas
			elseif look and look.Texture and (own or table.find(SkinCatalog.TextureSlots, slot)) then
				texture = textureId(look.Texture)
			end
		end
		if look then
			part.Color = look.Color
			part.Material = look.Material
		end
		if part:IsA("MeshPart") then
			part.TextureID = texture or ""
		end
	end
	model:SetAttribute("Sniper", rifle)
	model:SetAttribute("Skin", skinName)
end

return SniperSkins
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">SniperKit</string><ProtectedString name="Source"><![CDATA[--!strict
-- SniperKit (ModuleScript inside the SniperSystem folder).
--
-- Turns an imported rifle Model into a ready-to-hold Tool:
--   * fixes the size if the importer scaled it (uses SniperData.Size)
--   * applies a skin
--   * adds an invisible Handle at the rifle's grip and welds every part to it
--   * adds "Muzzle", "Aim" and "Grip" Attachments for your shooting code
--   * copies the arena stats onto the Tool as attributes
--
-- Put the imported rifle Models in SniperSystem.Models, named Hawkeye, Goliath, ...
--
--   local tool = SniperKit.BuildTool("Raptor", "Galaxy")
--   tool.Parent = player.Backpack

local root = script.Parent
local SniperData = require(root:WaitForChild("SniperData"))
local SniperSkins = require(root:WaitForChild("SniperSkins"))

local SniperKit = {}

-- Nudge this if the rifle sits wrong in your character's hand. The Handle's
-- front (-Z) points down the barrel, which is how Roblox holds tools forward.
SniperKit.Grip = CFrame.new(0, 0, 0)

local function findPart(container: Instance, slot: string): BasePart?
	for _, d in container:GetDescendants() do
		if d:IsA("BasePart") and SniperSkins.SlotOf(d) == slot then
			return d
		end
	end
	return nil
end

local function modelsFolder(): Instance
	local folder = root:FindFirstChild("Models")
	assert(folder, "[SniperKit] put your imported rifles in a Folder named Models inside SniperSystem")
	return folder
end

-- Importers sometimes treat file units as metres; scale back to the real size.
local function fixScale(model: Model, want: Vector3)
	local have = model:GetExtentsSize()
	local longest = math.max(have.X, have.Y, have.Z)
	local target = math.max(want.X, want.Y, want.Z)
	if longest > 0 and math.abs(longest / target - 1) > 0.03 then
		model:ScaleTo(model:GetScale() * target / longest)
	end
end

function SniperKit.BuildTool(template: Model | string, skinName: string?): Tool
	local source: Model = if typeof(template) == "string"
		then modelsFolder():FindFirstChild(template) :: Model
		else template
	assert(source, `[SniperKit] no rifle model named "{tostring(template)}" in SniperSystem.Models`)
	local rifle = source:GetAttribute("Sniper") or source.Name
	local data = SniperData[rifle]
	assert(data, `[SniperKit] no SniperData for "{rifle}" (rename the model to the rifle's name)`)

	local model = source:Clone()
	fixScale(model, data.Size)
	SniperSkins.Apply(model, skinName or "Factory", rifle)

	local tool = Instance.new("Tool")
	tool.Name = data.DisplayName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = SniperKit.Grip
	tool:SetAttribute("Sniper", rifle)
	tool:SetAttribute("Skin", skinName or "Factory")
	for stat, value in data.Stats do
		tool:SetAttribute(stat, value)
	end

	local gripInfo = data.Attachments.Grip
	local gripPart = findPart(model, gripInfo.Part)
	assert(gripPart, `[SniperKit] {rifle} has no {gripInfo.Part} part`)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.2, 0.2, 0.2)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.CanQuery = false
	handle.CanTouch = false
	handle.Massless = true
	-- keep the part's rotation so the Handle faces down the barrel even if
	-- the importer turned the whole model
	handle.CFrame = gripPart.CFrame * CFrame.new(gripInfo.Offset)
	handle.Parent = tool

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = part
			weld.Parent = handle
			part.Parent = tool
		end
	end
	model:Destroy()

	for name, info in data.Attachments do
		local part = findPart(tool, info.Part)
		if part then
			local att = Instance.new("Attachment")
			att.Name = name
			att.Position = info.Offset
			att.Parent = part
		end
	end
	return tool
end

-- Builds a rifle and puts it in the player's Backpack.
function SniperKit.Give(player: Player, rifleName: string, skinName: string?): Tool
	local tool = SniperKit.BuildTool(rifleName, skinName)
	tool.Parent = player:WaitForChild("Backpack")
	return tool
end

-- World position + direction a shot should leave from.
function SniperKit.GetMuzzle(tool: Tool): (Vector3, Vector3)
	local handle = tool:FindFirstChild("Handle") :: BasePart
	-- the Muzzle MeshPart shares the name, so look for the Attachment by class
	for _, d in tool:GetDescendants() do
		if d:IsA("Attachment") and d.Name == "Muzzle" then
			return d.WorldPosition, handle.CFrame.LookVector
		end
	end
	return handle.Position, handle.CFrame.LookVector
end

-- Re-skin a tool a player already holds.
function SniperKit.SetSkin(tool: Tool, skinName: string)
	SniperSkins.Apply(tool, skinName)
	tool:SetAttribute("Skin", skinName)
end

return SniperKit
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000006"><Properties><string name="Name">Models</string></Properties></Item></Item></roblox>
