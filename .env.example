# PostgreSQL connection string (Neon, Supabase, Railway, Vercel Postgres, or self-hosted).
# On Vercel, use the *pooled* connection string and make sure it is available at build time,
# because public pages are prerendered from the database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cheapnerds

# Public URL of the site, used for canonical URLs, sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string (32+ chars). Used to salt anonymous analytics visitor hashes.
# Generate one with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Optional: set to "true" if your database requires SSL but your URL has no sslmode param.
# DATABASE_SSL=true
